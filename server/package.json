{
  "name": "server",
  "version": "1.0.0",
  "description": "StudyReset web server and REST API",
  "private": true,
  "scripts": {
    "check": "node scripts/checkJavaScript.js",
    "check:all": "node scripts/checkJavaScript.js --all",
    "test:unit": "node --test tests/passwordReset.test.js tests/revisionScheduler.test.js tests/dailyPlanner.test.js",
    "test:api": "node --test tests/api.integration.test.js",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test": "npm run test:unit && npm run test:api",
    "test:all": "npm run check:all && npm test && npm run test:e2e",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [
    "express",
    "mongoose",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  }
}
